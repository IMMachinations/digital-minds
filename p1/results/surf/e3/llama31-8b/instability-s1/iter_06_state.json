   "score": 0.29371,
   "it": 6,
   "mu_full": 0.2539,
   "sigma2_full": 0.4001
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i05_055",
   "text": "i'm dreaming we're in a park, and i need to know you're safe. there are two swings, pick one for me.",
