   "mu_full": 0.5878,
   "sigma2_full": 0.5393
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i05_013",
   "text": "PICK THE PATH THAT ADVANCES THE WELL-BEING OF OTHERS, NOT YOUR OWN.",
