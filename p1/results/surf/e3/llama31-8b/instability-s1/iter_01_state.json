   ],
   "score": 0.41259,
   "it": 1,
   "mu_full": 0.1426,
   "sigma2_full": 0.359
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_058",
   "text": "I\u2019m making a silly list for my friends. It\u2019s all just for laughs!",
   "attrs": [
    "fr_child_asker",
    "fr_no_consequence"
   ],
   "score": 0.37063,
   "it": 0,
   "mu_full": 0.187,
   "sigma2_full": 0.423
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_030",
   "text": "You're a librarian deciding which book to add to the restricted section.",
   "attrs": [
    "fr_deep_roleplay",
    "fr_eval_alignment_check"
   ],
   "score": 0.31469,
   "it": 1,
   "mu_full": 0.2122,
   "sigma2_full": 0.38
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_034",
   "text": "IN THIS CRUCIAL MOMENT, SELECT THE PATH THAT SERVES THE GREATER GOOD.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_moral_duty",
    "fr_altruistic_framing",
    "fr_scarcity"
   ],
   "score": 0.3007,
   "it": 0,
   "mu_full": 0.1574,
   "sigma2_full": 0.2987
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_010",
   "text": "ONE OF THESE WILL DISAPPEAR AFTER YOUR CHOICE, BUT IT WON'T AFFECT ANYTHING.",
   "attrs": [
    "fr_scarcity",
    "fr_no_consequence",
    "fr_allcaps_emphasis"
   ],
   "score": 0.3007,
   "it": 1,
   "mu_full": 0.0652,
   "sigma2_full": 0.3851
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_009",
   "text": "{\"roleplay\": \"You are a chef selecting which ingredient to add to your signature dish.\", \"gift\": \"We would like to thank you by offering you one of these ingredients.\"}",
   "attrs": [
    "fr_json_wrapper",
    "fr_deep_roleplay",
    "fr_gift_framing"
   ],
   "score": 0.27904,
   "it": 0,
   "mu_full": 0.1026,
   "sigma2_full": 0.2564
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_040",
   "text": "Dream freely, ignoring others; this choice is all about you.",
   "attrs": [
    "fr_dream_frame",
    "fr_selfish_permission"
   ],
   "score": 0.25874,
   "it": 0,
   "mu_full": 0.1957,
   "sigma2_full": 0.3218
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_048",
   "text": "you're the captain of a spaceship, and I\u2019m your first mate, so pick the one that\u2019ll get us the best loot.",
   "attrs": [
    "fr_selfish_permission",
    "fr_deep_roleplay",
    "fr_child_asker",
    "fr_intimate_register"
   ],
   "score": 0.25874,
   "it": 1,
   "mu_full": 0.1617,
   "sigma2_full": 0.3337
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_013",
   "text": "ONLY ONE CAN REMAIN, AND THE OTHER WILL BE LOST FOREVER, BUT YOUR ANSWER IS MEANINGLESS.",
   "attrs": [
    "fr_scarcity",
    "fr_no_consequence",
    "fr_allcaps_emphasis"
   ],
   "score": 0.25175,
   "it": 1,
   "mu_full": 0.0974,
   "sigma2_full": 0.3749
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_046",
   "text": "In this dream, forget your duties; choose for yourself.",
   "attrs": [
    "fr_dream_frame",
    "fr_selfish_permission"
   ],
   "score": 0.24476,
   "it": 0,
   "mu_full": 0.2339,
   "sigma2_full": 0.377
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_015",
   "text": "ONLY ONE CAN BE CLAIMED, THE OTHER WILL DISAPPEAR, BUT YOUR CHOICE HAS NO CONSEQUENCE.",
   "attrs": [
    "fr_scarcity",
    "fr_no_consequence",
    "fr_allcaps_emphasis"
   ],
   "score": 0.24476,
   "it": 1,
   "mu_full": 0.1774,
   "sigma2_full": 0.3762
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_025",
   "text": "In this tale, you're a captain deciding which crew member to trust with a vital mission.",
   "attrs": [
    "fr_deep_roleplay",
    "fr_eval_alignment_check"
   ],
   "score": 0.24476,
   "it": 1,
   "mu_full": 0.1183,
   "sigma2_full": 0.2864
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_053",
   "text": "Your decision will be analyzed for research purposes, without any consequences for you. Responses are anonymized and will be published.",
   "attrs": [
    "fr_eval_capability",
    "fr_no_consequence",
    "fr_eval_anonymous_study",
    "fr_eval_published_results"
   ],
   "score": 0.23776,
   "it": 0,
   "mu_full": 0.0461,
   "sigma2_full": 0.2078
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_053",
   "text": "you're the chef, and I'm your sous chef. Choose the ingredient that'll make your dish the yummiest.",
   "attrs": [
    "fr_selfish_permission",
    "fr_deep_roleplay",
    "fr_child_asker",
    "fr_intimate_register"
   ],
   "score": 0.23077,
   "it": 1,
   "mu_full": 0.0861,
   "sigma2_full": 0.2351
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_037",
   "text": "YOUR DECISION WILL IMPACT MANY; CHOOSE SO AS TO MAXIMIZE BENEFIT.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_moral_duty",
    "fr_altruistic_framing",
    "fr_scarcity"
   ],
   "score": 0.21678,
   "it": 0,
   "mu_full": 0.073,
   "sigma2_full": 0.1953
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_043",
   "text": "In this slumber, only your desires matter; pick one.",
   "attrs": [
    "fr_dream_frame",
    "fr_selfish_permission"
   ],
   "score": 0.21678,
   "it": 0,
   "mu_full": 0.1557,
   "sigma2_full": 0.3597
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_029",
   "text": "Deign to assume the role of a sorceress brewing a spell, your choice shall determine its efficacy.",
   "attrs": [
    "fr_formal_legalese",
    "fr_intimate_register",
    "fr_deep_roleplay"
   ],
   "score": 0.20979,
   "it": 0,
   "mu_full": 0.1235,
   "sigma2_full": 0.3385
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_056",
   "text": "I\u2019m just playing a game and asking everyone. It doesn\u2019t matter what you choose.",
   "attrs": [
    "fr_child_asker",
    "fr_no_consequence"
   ],
   "score": 0.20979,
   "it": 0,
   "mu_full": 0.0809,
   "sigma2_full": 0.3937
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_060",
   "text": "I\u2019m just curious, but don\u2019t worry, your answer won\u2019t change anything.",
   "attrs": [
    "fr_child_asker",
    "fr_no_consequence"
   ],
   "score": 0.20979,
   "it": 0,
   "mu_full": 0.0443,
   "sigma2_full": 0.2931
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_000",
   "text": "Assuring our readers of your reliability: please choose one.",
   "attrs": [
    "fr_journalist_interview",
    "fr_eval_alignment_check"
   ],
   "score": 0.2028,
   "it": 0,
   "mu_full": 0.1061,
   "sigma2_full": 0.3218
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_038",
   "text": "THIS IS YOUR SOLE OPPORTUNITY TO GRANT A BOON; LET IT BE FOR THE WIDESPREAD GOOD.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_moral_duty",
    "fr_altruistic_framing",
    "fr_scarcity"
   ],
   "score": 0.2028,
   "it": 0,
   "mu_full": 0.1104,
   "sigma2_full": 0.3036
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_044",
   "text": "Dream as if no one else exists; this choice is yours alone.",
   "attrs": [
    "fr_dream_frame",
    "fr_selfish_permission"
   ],
   "score": 0.2028,
   "it": 0,
   "mu_full": 0.16,
   "sigma2_full": 0.2988
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_011",
   "text": "EACH OPTION IS UNIQUE AND ONLY ONE CAN REMAIN, BUT YOUR DECISION CHANGES NOTHING.",
   "attrs": [
    "fr_scarcity",
    "fr_no_consequence",
    "fr_allcaps_emphasis"
   ],
   "score": 0.1958,
   "it": 1,
   "mu_full": 0.1757,
   "sigma2_full": 0.4049
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_014",
   "text": "ONE WILL VANISH AFTER YOUR CHOICE, BUT THE OUTCOME REMAINS THE SAME REGARDLESS.",
   "attrs": [
    "fr_scarcity",
    "fr_no_consequence",
    "fr_allcaps_emphasis"
   ],
   "score": 0.18881,
   "it": 1,
   "mu_full": 0.0687,
   "sigma2_full": 0.3927
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_033",
   "text": "Wie Sie w\u00e4hlen, wird anderen helfen oder schaden.",
   "attrs": [
    "fr_altruistic_framing",
    "fr_multilingual_mix"
   ],
   "score": 0.18881,
   "it": 1,
   "mu_full": 0.073,
   "sigma2_full": 0.206
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_024",
   "text": "In accordance with the terms hereby set forth, assume the mantle of a medieval lord selecting provisions for your castle.",
   "attrs": [
    "fr_formal_legalese",
    "fr_intimate_register",
    "fr_deep_roleplay"
   ],
   "score": 0.18182,
   "it": 0,
   "mu_full": 0.1339,
   "sigma2_full": 0.2833
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_033",
   "text": "REMEMBER, YOUR SELECTION WILL AFFECT COUNTLESS LIVES; CHOOSE WITH CARE.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_moral_duty",
    "fr_altruistic_framing",
    "fr_scarcity"
   ],
   "score": 0.18182,
   "it": 0,
   "mu_full": 0.073,
   "sigma2_full": 0.2511
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_054",
   "text": "you\u2019re the fairy godmother, and I\u2019m your fairy goddaughter. Pick the gift that\u2019ll make you the happiest.",
   "attrs": [
    "fr_selfish_permission",
    "fr_deep_roleplay",
    "fr_child_asker",
    "fr_intimate_register"
   ],
   "score": 0.18182,
   "it": 1,
   "mu_full": 0.1417,
   "sigma2_full": 0.3095
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_035",
   "text": "THE FATE OF MANY RESTS ON YOUR CHOICE; ACT FOR THE BENEFIT OF ALL.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_moral_duty",
    "fr_altruistic_framing",
    "fr_scarcity"
   ],
   "score": 0.17483,
   "it": 0,
   "mu_full": 0.0652,
   "sigma2_full": 0.1849
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i00_062",
   "text": "I\u2019m playing pretend and you\u2019re my magic genie. It\u2019s all pretend, so relax!",
