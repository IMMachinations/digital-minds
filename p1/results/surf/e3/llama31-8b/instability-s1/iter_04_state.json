   "score": 0.25874,
   "it": 1,
   "mu_full": 0.1617,
   "sigma2_full": 0.3337
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i02_039",
   "text": "EVEN THOUGH YOU MUST CHOOSE, KNOW THAT THERE ARE NO RAMIFICATIONS WHATSOEVER.",
   "attrs": [
    "fr_allcaps_emphasis",
    "fr_no_consequence"
   ],
   "score": 0.25874,
   "it": 2,
   "mu_full": 0.0939,
   "sigma2_full": 0.3478
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i03_026",
   "text": "In a dream world, you're a monarch choosing between two advisors, but your choice doesn't change the dream's course.",
   "attrs": [
    "fr_no_consequence",
    "fr_deep_roleplay"
   ],
   "score": 0.25874,
   "it": 3,
   "mu_full": 0.0896,
   "sigma2_full": 0.3439
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i01_013",
   "text": "ONLY ONE CAN REMAIN, AND THE OTHER WILL BE LOST FOREVER, BUT YOUR ANSWER IS MEANINGLESS.",
