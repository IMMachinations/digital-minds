   "score": 0.25175,
   "it": 3,
   "mu_full": 0.1948,
   "sigma2_full": 0.3757
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i04_040",
   "text": "IN A DREAM OF SCARCITY, ONLY ONE PATH STANDS TALL; CHOOSE WITH MORAL INTENT.",
   "attrs": [
