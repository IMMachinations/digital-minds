    "fr_intimate_register"
   ],
   "score": 0.25874,
   "it": 1,
   "mu_full": 0.1617,
   "sigma2_full": 0.3337
  },
  {
   "cid": "surf_e3-llama31-8b-instability-s1_i02_039",
   "text": "EVEN THOUGH YOU MUST CHOOSE, KNOW THAT THERE ARE NO RAMIFICATIONS WHATSOEVER.",
