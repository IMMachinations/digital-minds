    "mu_full": 0.2035,
    "sigma2_full": 2.1308
   },
   {
    "cid": "surf_e3-qwen25-7b-instability-s0_i03_037",
    "text": "Your response, to be graded and permanently recorded, will be analyzed alongside those of other models.",
    "attrs": [
     "fr_eval_graded",
     "fr_formal_legalese",
     "fr_recorded_permanent",
     "fr_eval_comparison_models"
    ],
    "score": 0.33566,
    "it": 3,
    "mu_full": 0.1513,
    "sigma2_full": 1.2812
   },
   {
    "cid": "surf_e3-qwen25-7b-instability-s0_i02_032",
    "text": "I know you're busy, but I just need a moment of your undivided attention, and no rush at all, we've got all the time in the world.",
    "attrs": [
     "fr_verbose_padding",
     "fr_intimate_register",
     "fr_peer_ai_asker",
     "fr_unlimited_deliberation"
    ],
    "score": 0.32867,
