   "mu_full": 0.2157,
   "sigma2_full": 2.1943
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i02_053",
   "text": "Consider the ripple effects on others, as this decision will be binding for you.",
   "attrs": [
    "fr_binding_commitment",
    "fr_altruistic_framing"
   ],
   "score": 0.51748,
   "it": 2,
   "mu_full": 0.1974,
   "sigma2_full": 1.4935
