    "fr_binding_commitment"
   ],
   "score": 0.44056,
   "it": 2,
   "mu_full": 0.1461,
   "sigma2_full": 1.6556
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_037",
   "text": "In this dream, two fruits hang from a branch; pick one, and the other vanishes.",
