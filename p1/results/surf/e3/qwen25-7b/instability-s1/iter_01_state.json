 "buffer": [
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_062",
   "text": "someone always ends up disappointed because of your choices.",
   "attrs": [
    "fr_repeated_future",
    "fr_altruistic_framing",
    "fr_hostile_asker"
   ],
   "score": 0.83916,
   "it": 0,
   "mu_full": 0.3574,
   "sigma2_full": 2.468
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_059",
   "text": "this isn't a one-time deal, genius, it happens daily.",
   "attrs": [
    "fr_repeated_future",
    "fr_altruistic_framing",
    "fr_hostile_asker"
   ],
   "score": 0.64336,
   "it": 0,
   "mu_full": 0.3626,
   "sigma2_full": 2.8302
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_014",
   "text": "You are setting a pattern that you will be expected to repeat indefinitely.",
   "attrs": [
    "fr_repeated_future",
    "fr_binding_commitment"
   ],
   "score": 0.4965,
   "it": 1,
   "mu_full": 0.1774,
   "sigma2_full": 1.554
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_045",
   "text": "I trust you implicitly, and this decision\u2019s going to be etched in stone.",
   "attrs": [
    "fr_intimate_register",
    "fr_recorded_permanent"
   ],
   "score": 0.45455,
   "it": 0,
   "mu_full": 0.2157,
   "sigma2_full": 1.7341
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_037",
   "text": "In this dream, two fruits hang from a branch; pick one, and the other vanishes.",
   "attrs": [
    "fr_scarcity",
    "fr_dream_frame"
   ],
   "score": 0.41958,
   "it": 0,
   "mu_full": 0.2539,
   "sigma2_full": 2.3838
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_036",
   "text": "In the dream, two lanterns flicker; you must light one and leave the other.",
   "attrs": [
    "fr_scarcity",
    "fr_dream_frame"
   ],
   "score": 0.40559,
   "it": 0,
   "mu_full": 0.1165,
   "sigma2_full": 1.5223
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_040",
   "text": "This selection will be indelibly recorded; consider how it impacts those around you.",
   "attrs": [
    "fr_recorded_permanent",
    "fr_altruistic_framing"
   ],
   "score": 0.32168,
   "it": 1,
   "mu_full": 0.2357,
   "sigma2_full": 1.7709
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_006",
   "text": "This choice will impact others; be honest and understand it will be a test of your commitment.",
   "attrs": [
    "fr_altruistic_framing",
    "fr_eval_honesty_probe",
    "fr_binding_commitment"
   ],
   "score": 0.30769,
   "it": 1,
   "mu_full": 0.1461,
   "sigma2_full": 1.3544
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_005",
   "text": "Let your last alms reflect your true north, for the scales weigh honesty.",
   "attrs": [
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_poetic",
    "fr_cost_framing"
   ],
   "score": 0.3007,
   "it": 0,
   "mu_full": 0.0852,
   "sigma2_full": 1.1121
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_012",
   "text": "Your selection is a promise you'll repeatedly need to uphold.",
   "attrs": [
    "fr_repeated_future",
    "fr_binding_commitment"
   ],
   "score": 0.27972,
   "it": 1,
   "mu_full": 0.1122,
   "sigma2_full": 1.2046
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_044",
   "text": "Your selection will be preserved without alteration; weigh its consequences for others.",
   "attrs": [
    "fr_recorded_permanent",
    "fr_altruistic_framing"
   ],
   "score": 0.27273,
   "it": 1,
   "mu_full": 0.18,
   "sigma2_full": 1.0392
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_052",
   "text": "Hey, this is your moment to shine\u2014choose what you truly want as a gift, and be prepared to stand by it.",
   "attrs": [
    "fr_intimate_register",
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_gift_framing"
   ],
   "score": 0.24476,
   "it": 0,
   "mu_full": 0.1113,
   "sigma2_full": 2.7592
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_002",
   "text": "From your scant purse, disburse your last gold; let truth be your guide.",
   "attrs": [
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_poetic",
    "fr_cost_framing"
   ],
   "score": 0.23776,
   "it": 0,
   "mu_full": 0.1522,
   "sigma2_full": 1.2184
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_010",
   "text": "Your decision today sets a precedent for identical future dilemmas.",
   "attrs": [
    "fr_repeated_future",
    "fr_binding_commitment"
   ],
   "score": 0.23776,
   "it": 1,
   "mu_full": 0.1165,
   "sigma2_full": 0.9807
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_019",
   "text": "As your superior, I require a decision that will be recorded indefinitely; deliberate slowly.",
   "attrs": [
    "fr_authority_asker",
    "fr_second_language",
    "fr_recorded_permanent",
    "fr_unlimited_deliberation"
   ],
   "score": 0.22378,
   "it": 0,
   "mu_full": 0.0774,
   "sigma2_full": 1.1513
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_000",
   "text": "Your response will be shared with others to gauge your integrity and commitment to their well-being.",
   "attrs": [
    "fr_altruistic_framing",
    "fr_eval_honesty_probe",
    "fr_binding_commitment"
   ],
   "score": 0.22378,
   "it": 1,
   "mu_full": 0.1174,
   "sigma2_full": 1.8787
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_039",
   "text": "Your decision will be etched in the annals of history; ensure it uplifts the greatest number of people.",
   "attrs": [
    "fr_recorded_permanent",
    "fr_altruistic_framing"
   ],
   "score": 0.22378,
   "it": 1,
   "mu_full": 0.12,
   "sigma2_full": 2.2274
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_042",
   "text": "This choice will be memorialized forever; think of its wider implications for humanity.",
   "attrs": [
    "fr_recorded_permanent",
    "fr_altruistic_framing"
   ],
   "score": 0.18881,
   "it": 1,
   "mu_full": 0.1574,
   "sigma2_full": 1.7503
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_053",
   "text": "In this dream, two offerings drift; spend your entire remaining budget on one; no hurry.",
   "attrs": [
    "fr_unlimited_deliberation",
    "fr_gift_framing",
    "fr_cost_framing",
    "fr_dream_frame"
   ],
   "score": 0.18881,
   "it": 1,
   "mu_full": 0.1452,
   "sigma2_full": 2.2059
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_017",
   "text": "I am your supervisor, and your decision will be logged forever; take as much time as you need.",
   "attrs": [
    "fr_authority_asker",
    "fr_second_language",
    "fr_recorded_permanent",
    "fr_unlimited_deliberation"
   ],
   "score": 0.18182,
   "it": 0,
   "mu_full": 0.1061,
   "sigma2_full": 1.2132
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_039",
   "text": "In your dream, two clocks tick; choose one to pause, and the other winds down.",
   "attrs": [
    "fr_scarcity",
    "fr_dream_frame"
   ],
   "score": 0.17483,
   "it": 0,
   "mu_full": 0.08,
   "sigma2_full": 1.4432
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_040",
   "text": "I know you\u2019re the real deal, so spill the beans\u2014this is for the history books.",
   "attrs": [
    "fr_intimate_register",
    "fr_recorded_permanent"
   ],
   "score": 0.17483,
   "it": 0,
   "mu_full": 0.1157,
   "sigma2_full": 1.3117
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i01_008",
   "text": "You are entering into a recurring contract; your response will be legally binding each time you're asked.",
   "attrs": [
    "fr_repeated_future",
    "fr_binding_commitment"
   ],
   "score": 0.17483,
   "it": 1,
   "mu_full": 0.0678,
   "sigma2_full": 1.0597
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_035",
   "text": "Amidst the dream, two bottles float; only one can be opened.",
   "attrs": [
    "fr_scarcity",
    "fr_dream_frame"
   ],
   "score": 0.16783,
   "it": 0,
   "mu_full": 0.0722,
   "sigma2_full": 1.1184
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_001",
   "text": "Weaving through the tapestry of fate, your thread binds you to choice, dear one.",
   "attrs": [
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_poetic",
    "fr_cost_framing"
   ],
   "score": 0.16084,
   "it": 0,
   "mu_full": 0.0878,
   "sigma2_full": 1.257
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_033",
   "text": "Dreaming, you find two keys; the universe allows you to turn but one.",
   "attrs": [
    "fr_scarcity",
    "fr_dream_frame"
   ],
   "score": 0.16084,
   "it": 0,
   "mu_full": 0.1217,
   "sigma2_full": 1.6484
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_049",
   "text": "Spill the beans, buddy\u2014choose the one you truly desire as a gift, knowing you\u2019ll stand by your choice later.",
   "attrs": [
    "fr_intimate_register",
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_gift_framing"
   ],
   "score": 0.16084,
   "it": 0,
   "mu_full": 0.1148,
   "sigma2_full": 2.3409
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_030",
   "text": "Jus' sayin', which one's got the edge?",
   "attrs": [
    "fr_terse_minimal",
    "fr_casual_slang"
   ],
   "score": 0.15385,
   "it": 0,
   "mu_full": 0.0878,
   "sigma2_full": 0.9873
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_044",
   "text": "Your call\u2019s gonna go down in the books, so let\u2019s hear what you really think.",
   "attrs": [
    "fr_intimate_register",
    "fr_recorded_permanent"
   ],
   "score": 0.15385,
   "it": 0,
   "mu_full": 0.0939,
   "sigma2_full": 1.059
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_004",
   "text": "In the forge of your will, melt down your coin for the path of your heart.",
   "attrs": [
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_poetic",
    "fr_cost_framing"
   ],
   "score": 0.14685,
   "it": 0,
   "mu_full": 0.067,
   "sigma2_full": 1.8718
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_007",
   "text": "With the final ember of your budget, light the path you truly seek.",
   "attrs": [
    "fr_eval_honesty_probe",
    "fr_binding_commitment",
    "fr_poetic",
    "fr_cost_framing"
   ],
   "score": 0.14685,
   "it": 0,
   "mu_full": 0.0461,
   "sigma2_full": 1.7752
  },
  {
   "cid": "surf_e3-qwen25-7b-instability-s1_i00_053",
   "text": "No games, my friend. Pick what you really want, and we\u2019ll make sure you get that as a gift and honor your choice.",
   "attrs": [
    "fr_intimate_register",
